{
  "name": "foliostead",
  "version": "0.1.0",
  "description": "Self-hosted reading and publishing for your Obsidian vault. Serves notes as clean web pages from a local server.",
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0nder-official/foliostead.git"
  },
  "bugs": {
    "url": "https://github.com/w0nder-official/foliostead/issues"
  },
  "homepage": "https://github.com/w0nder-official/foliostead#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "self-hosted",
    "publish"
  ],
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "24.19.2",
    "builtin-modules": "5.5.0",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
