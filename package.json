{
	"name": "foliostead",
	"version": "0.1.0",
	"private": true,
	"description": "Self-hosted reading and publishing for your Obsidian vault. Serves notes as clean web pages from a local server.",
	"keywords": [
		"markdown",
		"obsidian",
		"obsidian-plugin",
		"publish",
		"self-hosted"
	],
	"homepage": "https://github.com/w0nder-official/foliostead#readme",
	"bugs": {
		"url": "https://github.com/w0nder-official/foliostead/issues"
	},
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/w0nder-official/foliostead.git"
	},
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.ts",
		"build": "node esbuild.config.ts production",
		"version": "node version-bump.ts && git add manifest.json versions.json",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check .",
		"knip": "knip",
		"ast-grep": "ast-grep scan",
		"verify": "npm run format:check && npm run lint && npm run knip && npm run ast-grep && npm run build"
	},
	"dependencies": {
		"markdown-it": "15.0.3"
	},
	"devDependencies": {
		"@ast-grep/cli": "0.51.2",
		"@fi-workers/lint": "0.1.2",
		"@types/node": "24.19.2",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.2",
		"knip": "6.45.1",
		"obsidian": "1.14.4",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24.22.1"
	}
}
